@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskMaster Pro</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()

    @if (User.Identity?.IsAuthenticated == true)
    {
        var role = User.FindFirstValue(ClaimTypes.Role) ?? "user";
        var isAdmin = role.Equals("admin", StringComparison.OrdinalIgnoreCase);
        var fullName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity.Name;

        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand-logo" asp-controller="Todos" asp-action="Index">
                    <div class="brand-icon-box">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <span>TaskMaster<span class="text-primary fw-light">Pro</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#topNavContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="topNavContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-pill-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Todos" ? "active" : "")" 
                               asp-controller="Todos" asp-action="Index">
                                <i class="bi bi-list-task"></i>
                                <span>@(isAdmin ? "All Tasks" : "My Tasks")</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-pill-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" 
                               asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i>
                                <span>KPI Overview</span>
                            </a>
                        </li>

                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-pill-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" 
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock-fill text-primary"></i>
                                    <span>Admin Hub</span>
                                    <span class="badge bg-primary text-white" style="font-size: 0.65rem;">ADMIN</span>
                                </a>
                                <ul class="dropdown-menu border-0 shadow-lg rounded-3 py-2">
                                    <li>
                                        <a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Reports">
                                            <i class="bi bi-pie-chart-fill text-primary"></i>
                                            <div>
                                                <div class="fw-semibold">Category Reports & KPIs</div>
                                                <small class="text-muted">Year & month filtered metrics</small>
                                            </div>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Users">
                                            <i class="bi bi-people-fill text-indigo"></i>
                                            <div>
                                                <div class="fw-semibold">All App Users</div>
                                                <small class="text-muted">Directory & user productivity</small>
                                            </div>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <!-- Quick Add Task Button -->
                        <button type="button" class="btn-primary-custom" onclick="openCreateTodoModal()">
                            <i class="bi bi-plus-lg"></i>
                            <span>New Task</span>
                        </button>

                        <!-- Notification Bell with real-time dropdown -->
                        <div class="dropdown position-relative">
                            <button class="btn btn-ghost-custom position-relative p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Start Time Alerts">
                                <i class="bi bi-bell-fill fs-5 text-secondary"></i>
                                <span id="notifBadge" class="pulse-badge" style="display: none;"></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end notif-dropdown p-0">
                                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                                    <div class="fw-bold small text-dark">
                                        <i class="bi bi-alarm me-1 text-primary"></i> Scheduled Start Alerts
                                    </div>
                                    <span id="notifCount" class="badge bg-danger rounded-pill">0</span>
                                </div>
                                <div id="notifItemsList">
                                    <div class="p-3 text-center text-muted small">
                                        <i class="bi bi-bell-slash me-1"></i> No new start-time alerts
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-ghost-custom d-flex align-items-center gap-2 py-1 px-2" type="button" data-bs-toggle="dropdown">
                                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 32px; height: 32px;">
                                    @(fullName?.Length > 0 ? fullName[0].ToString().ToUpper() : "U")
                                </div>
                                <div class="text-start d-none d-sm-block">
                                    <div class="fw-semibold small leading-tight">@fullName</div>
                                    <div class="badge @(isAdmin ? "bg-primary" : "bg-secondary")" style="font-size: 0.65rem;">
                                        @role.ToUpper()
                                    </div>
                                </div>
                                <i class="bi bi-chevron-down text-muted small"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-3">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold">@fullName</div>
                                    <div class="small text-muted">Signed in as <span class="fw-semibold">@User.Identity.Name</span></div>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-2 text-muted"></i> My KPI Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Todos" asp-action="Index">
                                        <i class="bi bi-list-check me-2 text-muted"></i> Task Workspace
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item text-danger py-2">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    }

    <main role="main" class="py-4">
        <div class="container-fluid px-lg-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- SignalR Live Start-Alert Toast Container -->
    <div id="liveToastContainer" class="live-alert-toast-container"></div>

    <footer class="footer mt-auto py-3 bg-white border-top text-muted small">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                &copy; @DateTime.UtcNow.Year <strong>TaskMaster Pro</strong> &mdash; Modern Task Management with Real-Time Scheduling
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="d-inline-flex align-items-center gap-1 text-success">
                    <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> Local SQL Server Connected
                </span>
                <span class="text-secondary">&bull;</span>
                <span class="d-inline-flex align-items-center gap-1 text-primary">
                    <i class="bi bi-broadcast"></i> SignalR Live
                </span>
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
