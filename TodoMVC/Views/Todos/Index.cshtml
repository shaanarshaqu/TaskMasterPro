@model TodoMVC.Models.ViewModels.TodoListViewModel
@{
    ViewData["Title"] = Model.IsAdmin && Model.SelectedUserId.HasValue ? "Filtered Tasks" : (Model.IsAdmin ? "All Tasks (Admin)" : "My Tasks");
    var totalCount = Model.Todos.Count;
    var completedCount = Model.Todos.Count(t => t.Status == "Completed");
    var inProgressCount = Model.Todos.Count(t => t.Status == "InProgress");
    var pendingCount = Model.Todos.Count(t => t.Status == "Pending");
    var holdCount = Model.Todos.Count(t => t.Status == "Hold");

    var statusColumns = new[]
    {
        new { Key = "Pending", Name = "Pending", Icon = "bi-hourglass-split", Color = "#64748B", LightBg = "#F1F5F9" },
        new { Key = "InProgress", Name = "In Progress", Icon = "bi-play-circle-fill", Color = "#D97706", LightBg = "#FFFBEB" },
        new { Key = "Hold", Name = "On Hold", Icon = "bi-pause-circle-fill", Color = "#7C3AED", LightBg = "#F5F3FF" },
        new { Key = "Completed", Name = "Completed", Icon = "bi-check-circle-fill", Color = "#059669", LightBg = "#ECFDF5" }
    };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold tracking-tight text-dark mb-0">
                @(Model.IsAdmin ? (Model.SelectedUserId.HasValue ? "User Tasks" : "All Organization Tasks") : "My Task Workspace")
            </h2>
            <span class="badge bg-white text-muted border px-2 py-1 fs-6">@totalCount</span>
            @if (Model.IsAdmin)
            {
                <span class="badge bg-primary text-white" style="font-size: 0.7rem;">Admin View: All Users Visible</span>
            }
        </div>
        <p class="text-muted small mb-0 mt-1">
            Manage your scheduled tasks, track real-time progression, and resolve time conflicts.
        </p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <!-- View Toggle (List vs Kanban Board) -->
        <div class="btn-group p-1 bg-white border rounded-3 shadow-sm" role="group">
            <a asp-action="Index" 
               asp-route-search="@Model.Search" 
               asp-route-status="@Model.Status" 
               asp-route-categoryId="@Model.CategoryId" 
               asp-route-priority="@Model.Priority" 
               asp-route-userId="@Model.SelectedUserId" 
               asp-route-viewMode="list" 
               class="btn btn-sm @(Model.ViewMode == "list" ? "btn-primary shadow-sm" : "btn-light text-muted") rounded-2">
                <i class="bi bi-list-ul me-1"></i> List
            </a>
            <a asp-action="Index" 
               asp-route-search="@Model.Search" 
               asp-route-status="@Model.Status" 
               asp-route-categoryId="@Model.CategoryId" 
               asp-route-priority="@Model.Priority" 
               asp-route-userId="@Model.SelectedUserId" 
               asp-route-viewMode="board" 
               class="btn btn-sm @(Model.ViewMode == "board" ? "btn-primary shadow-sm" : "btn-light text-muted") rounded-2">
                <i class="bi bi-kanban me-1"></i> Board
            </a>
        </div>

        <button type="button" class="btn-primary-custom" onclick="openCreateTodoModal()">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Create Todo</span>
        </button>
    </div>
</div>

<!-- Quick Mini-Stats Strip -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background: #F1F5F9; color: #475569;">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Pending</div>
                <div class="fs-4 fw-bold text-dark">@pendingCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background: #FFFBEB; color: #D97706;">
                <i class="bi bi-play-circle-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">In Progress</div>
                <div class="fs-4 fw-bold text-warning">@inProgressCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background: #F5F3FF; color: #7C3AED;">
                <i class="bi bi-pause-circle-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">On Hold</div>
                <div class="fs-4 fw-bold text-purple" style="color: #7C3AED;">@holdCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background: #ECFDF5; color: #059669;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Completed</div>
                <div class="fs-4 fw-bold text-success">@completedCount</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters Bar Card -->
<div class="app-card mb-4 p-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <input type="hidden" name="viewMode" value="@Model.ViewMode" />

        <div class="col-12 col-md-3">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Search tasks by title..." />
            </div>
        </div>

        <div class="col-6 col-md-2">
            <select name="status" class="form-select form-select-sm">
                <option value="All">All Statuses</option>
                <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                <option value="InProgress" selected="@(Model.Status == "InProgress")">In Progress</option>
                <option value="Hold" selected="@(Model.Status == "Hold")">On Hold</option>
                <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
            </select>
        </div>

        <div class="col-6 col-md-2">
            <select name="categoryId" class="form-select form-select-sm">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <select name="priority" class="form-select form-select-sm">
                <option value="All">All Priorities</option>
                <option value="Low" selected="@(Model.Priority == "Low")">Low</option>
                <option value="Medium" selected="@(Model.Priority == "Medium")">Medium</option>
                <option value="High" selected="@(Model.Priority == "High")">High</option>
                <option value="Urgent" selected="@(Model.Priority == "Urgent")">Urgent</option>
            </select>
        </div>

        @if (Model.IsAdmin)
        {
            <div class="col-6 col-md-2">
                <select name="userId" class="form-select form-select-sm">
                    <option value="">All Users</option>
                    @foreach (var user in Model.AllUsers)
                    {
                        <option value="@user.Id" selected="@(Model.SelectedUserId == user.Id)">
                            @user.FullName (@user.Username)
                        </option>
                    }
                </select>
            </div>
        }

        <div class="col-12 col-md-1 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary w-100" title="Apply Filters">
                <i class="bi bi-funnel"></i> Filter
            </button>
            <a asp-action="Index" asp-route-viewMode="@Model.ViewMode" class="btn btn-sm btn-outline-secondary" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- ================= LIST VIEW ================= -->
@if (Model.ViewMode == "list")
{
    <div class="app-card overflow-hidden">
        @if (!Model.Todos.Any())
        {
            <div class="text-center py-5">
                <div class="stat-icon mx-auto mb-3" style="width: 60px; height: 60px; background-color: #F8FAFC; color: #94A3B8; font-size: 1.75rem;">
                    <i class="bi bi-inbox"></i>
                </div>
                <h5 class="fw-bold text-dark">No tasks found</h5>
                <p class="text-muted small">No scheduled tasks match your filter criteria.</p>
                <button type="button" class="btn btn-sm btn-primary-custom" onclick="openCreateTodoModal()">
                    <i class="bi bi-plus-lg me-1"></i> Add Your First Task
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table custom-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Status</th>
                            <th>Task Details</th>
                            <th>Category</th>
                            <th>Time Window</th>
                            <th>Priority</th>
                            @if (Model.IsAdmin)
                            {
                                <th>Assigned To</th>
                            }
                            <th class="text-end" style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Todos)
                        {
                            var statusClass = item.Status.ToLowerInvariant() switch
                            {
                                "completed" => "status-completed",
                                "inprogress" => "status-inprogress",
                                "hold" => "status-hold",
                                _ => "status-pending"
                            };

                            var priorityClass = item.Priority.ToLowerInvariant() switch
                            {
                                "urgent" => "priority-urgent",
                                "high" => "priority-high",
                                "low" => "priority-low",
                                _ => "priority-medium"
                            };

                            var rowClass = item.IsOverdue ? "overdue-strip" : (item.IsActiveNow ? "active-now-strip" : "");

                            <tr class="@rowClass">
                                <td>
                                    <!-- Interactive Status Dropdown -->
                                    <div class="dropdown">
                                        <button class="badge-status @statusClass border-0 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            @item.Status
                                        </button>
                                        <ul class="dropdown-menu border-0 shadow-sm rounded-3 py-1">
                                            <li><button class="dropdown-item small py-1" onclick="quickUpdateStatus(@item.Id, 'Pending')"><i class="bi bi-circle text-secondary me-2"></i> Pending</button></li>
                                            <li><button class="dropdown-item small py-1" onclick="quickUpdateStatus(@item.Id, 'InProgress')"><i class="bi bi-play-circle text-warning me-2"></i> In Progress</button></li>
                                            <li><button class="dropdown-item small py-1" onclick="quickUpdateStatus(@item.Id, 'Hold')"><i class="bi bi-pause-circle text-purple me-2"></i> On Hold</button></li>
                                            <li><button class="dropdown-item small py-1" onclick="quickUpdateStatus(@item.Id, 'Completed')"><i class="bi bi-check-circle text-success me-2"></i> Completed</button></li>
                                        </ul>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark @(item.Status == "Completed" ? "text-decoration-line-through text-muted" : "")">
                                        @item.Title
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="text-muted small text-truncate" style="max-width: 320px;">
                                            @item.Description
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="category-pill" style="border-left: 3px solid @item.CategoryColor;">
                                        <i class="bi @item.CategoryIcon" style="color: @item.CategoryColor;"></i>
                                        <span>@item.CategoryName</span>
                                    </span>
                                </td>
                                <td>
                                    <div class="small">
                                        <div class="d-flex align-items-center gap-1">
                                            <i class="bi bi-clock-history text-muted"></i>
                                            <span class="fw-semibold text-dark">@item.StartTime.ToString("MMM dd, yyyy HH:mm")</span>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.775rem;">
                                            To: @item.ExpectedEndTime.ToString("MMM dd, yyyy HH:mm")
                                            <span class="badge bg-light text-secondary ms-1">@item.DurationHours.ToString("0.1") hrs</span>
                                        </div>
                                    </div>
                                    @if (item.IsActiveNow)
                                    {
                                        <span class="badge bg-warning text-dark mt-1" style="font-size: 0.65rem;">
                                            <i class="bi bi-broadcast"></i> ACTIVE RIGHT NOW
                                        </span>
                                    }
                                    else if (item.IsOverdue)
                                    {
                                        <span class="badge bg-danger text-white mt-1" style="font-size: 0.65rem;">
                                            <i class="bi bi-exclamation-circle"></i> OVERDUE
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge-priority @priorityClass">@item.Priority</span>
                                </td>
                                @if (Model.IsAdmin)
                                {
                                    <td>
                                        <div class="d-flex align-items-center gap-1 small">
                                            <i class="bi bi-person-circle text-muted"></i>
                                            <span class="fw-medium">@item.FullName</span>
                                        </div>
                                    </td>
                                }
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary border-0 p-1" onclick="openEditTodoModal(@item.Id)" title="Edit Task">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger border-0 p-1" onclick="deleteTodo(@item.Id, '@item.Title.Replace("'", "\\'")')" title="Delete Task">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
<!-- ================= KANBAN BOARD VIEW ================= -->
else
{
    <div class="kanban-board">
        @foreach (var col in statusColumns)
        {
            var colTasks = Model.Todos.Where(t => t.Status == col.Key).ToList();

            <div class="kanban-column">
                <div class="kanban-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @col.Icon" style="color: @col.Color;"></i>
                        <span>@col.Name</span>
                    </div>
                    <span class="badge bg-white text-dark shadow-sm px-2 py-1">@colTasks.Count</span>
                </div>

                <div class="kanban-tasks-list flex-grow-1">
                    @if (!colTasks.Any())
                    {
                        <div class="text-center py-4 text-muted small border rounded-3 bg-white border-dashed p-3">
                            No tasks in this lane
                        </div>
                    }
                    else
                    {
                        @foreach (var item in colTasks)
                        {
                            var priorityClass = item.Priority.ToLowerInvariant() switch
                            {
                                "urgent" => "priority-urgent",
                                "high" => "priority-high",
                                "low" => "priority-low",
                                _ => "priority-medium"
                            };

                            var cardBorder = item.IsOverdue ? "border-danger border-2" : "";

                            <div class="kanban-task-card @cardBorder">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="category-pill" style="border-left: 3px solid @item.CategoryColor;">
                                        <i class="bi @item.CategoryIcon" style="color: @item.CategoryColor;"></i>
                                        <span>@item.CategoryName</span>
                                    </span>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm py-1">
                                            <li><button class="dropdown-item small" onclick="openEditTodoModal(@item.Id)"><i class="bi bi-pencil me-2"></i> Edit</button></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><button class="dropdown-item small text-secondary" onclick="quickUpdateStatus(@item.Id, 'Pending')">Move to Pending</button></li>
                                            <li><button class="dropdown-item small text-warning" onclick="quickUpdateStatus(@item.Id, 'InProgress')">Move to In Progress</button></li>
                                            <li><button class="dropdown-item small text-purple" onclick="quickUpdateStatus(@item.Id, 'Hold')">Move to On Hold</button></li>
                                            <li><button class="dropdown-item small text-success" onclick="quickUpdateStatus(@item.Id, 'Completed')">Move to Completed</button></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><button class="dropdown-item small text-danger" onclick="deleteTodo(@item.Id, '@item.Title.Replace("'", "\\'")')"><i class="bi bi-trash me-2"></i> Delete</button></li>
                                        </ul>
                                    </div>
                                </div>

                                <h6 class="fw-bold text-dark mb-1">@item.Title</h6>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="text-muted small mb-2 line-clamp-2" style="font-size: 0.8rem;">@item.Description</p>
                                }

                                <div class="bg-light p-2 rounded-2 mb-2" style="font-size: 0.75rem;">
                                    <div class="d-flex align-items-center gap-1 text-dark fw-medium">
                                        <i class="bi bi-calendar-event"></i> @item.StartTime.ToString("MMM dd, HH:mm")
                                    </div>
                                    <div class="text-muted">
                                        End: @item.ExpectedEndTime.ToString("MMM dd, HH:mm")
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge-priority @priorityClass">@item.Priority</span>
                                    @if (Model.IsAdmin)
                                    {
                                        <span class="small text-muted" title="@item.FullName">
                                            <i class="bi bi-person"></i> @item.Username
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

<!-- ================= MODAL: CREATE / EDIT TODO WITH OVERLAP NOTIFICATION ================= -->
<div class="modal fade" id="todoModal" tabindex="-1" aria-labelledby="todoModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-xl rounded-4">
            <div class="modal-header border-bottom py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="stat-icon" style="width: 36px; height: 36px; background-color: #EEF2FF; color: #4F46E5; font-size: 1.1rem;">
                        <i class="bi bi-calendar2-check"></i>
                    </div>
                    <h5 class="modal-title fw-bold text-dark" id="todoModalTitle">Create New Todo</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="todoModalForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="todoId" value="0" />

                    <!-- TIME SLOT CONFLICT WARNING ALERT (Shown in real-time or when server rejects overlap) -->
                    <div id="modalOverlapAlert" class="conflict-alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
                        <div>
                            <span id="modalOverlapMsg">
                                <strong>Time Conflict:</strong> You already have a task scheduled in this time interval. Tasks cannot overlap.
                            </span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-secondary">Task Title <span class="text-danger">*</span></label>
                            <input type="text" id="todoTitle" class="form-control" placeholder="e.g. Design Architecture Diagram" required maxlength="200" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Category <span class="text-danger">*</span></label>
                            <select id="todoCategory" class="form-select" required>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Priority</label>
                            <select id="todoPriority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>

                        <!-- Date & Time Row with Real-Time Overlap Detection -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-secondary">
                                <i class="bi bi-clock me-1 text-primary"></i> Start Time <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local" id="todoStartTime" class="form-control" required />
                            <div class="form-text" style="font-size: 0.75rem;">
                                You will receive a live notification right as this task starts.
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-secondary">
                                <i class="bi bi-clock-history me-1 text-primary"></i> Expected End Time <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local" id="todoEndTime" class="form-control" required />
                            <div class="form-text" style="font-size: 0.75rem;">
                                Cannot overlap with any other scheduled task.
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Initial Status</label>
                            <select id="todoStatus" class="form-select">
                                <option value="Pending" selected>Pending</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Hold">On Hold</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>

                        @if (Model.IsAdmin)
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold text-secondary">Assign To User (Admin Option)</label>
                                <select id="todoAssignedUser" class="form-select">
                                    @foreach (var u in Model.AllUsers)
                                    {
                                        <option value="@u.Id" selected="@(u.Id == Model.CurrentUserId)">@u.FullName (@u.Username)</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-secondary">Description (Optional)</label>
                            <textarea id="todoDescription" class="form-control" rows="3" placeholder="Add specific notes, checklist, or deliverables..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top py-3 px-4 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-ghost-custom" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="btnSaveTodo" class="btn btn-primary-custom">
                        <i class="bi bi-check-lg me-1"></i> Save Task
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
